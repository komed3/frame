{
  "name": "frame",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev tsx src/server/run.ts",
    "build:server": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "cross-env NODE_ENV=production node dist/server/run.js"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
