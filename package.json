{
  "name": "frame",
  "private": true,
  "description": "Private self-hosted video management platform",
  "version": "2.0.0",
  "license": "MIT",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://github.com/komed3/frame",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "bin": {
    "frame": "dist/maintenance/run.js"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=dev tsx src/server/run.ts",
    "frame:dev": "tsx src/maintenance/run.ts",
    "build:server": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:client": "vite build",
    "format": "prettier --ignore-path \"\" --write \"dist/**/*.js\" --log-level warn",
    "build": "npm run build:server && npm run format && npm run build:client",
    "start": "cross-env NODE_ENV=production node dist/server/run.js",
    "frame": "node dist/maintenance/run.js"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
